# Git
.git
.gitignore
.gitattributes

# Dependencies (will be installed inside container)
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment files (use docker-compose environment instead)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# IDE and Editor files
.vscode
.idea
*.swp
*.swo
*~

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Coverage directory used by tools like istanbul
coverage
.nyc_output

# Dependency directories
jspm_packages

# Optional npm cache directory
.npm

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# Build outputs
dist
build

# Documentation (not needed in container)
README.md
*.md
docs/

# Docker files (not needed in container)
Dockerfile*
docker-compose*.yml
.dockerignore

# Temporary files
*.tmp
*.temp

# Test files (if any)
test/
tests/
*.test.js
*.spec.js

# CI/CD
.github
.gitlab-ci.yml
.travis.yml

